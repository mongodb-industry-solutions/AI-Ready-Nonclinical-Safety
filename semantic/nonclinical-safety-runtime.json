{
  "apiVersion": "contextobjects.dev/runtime-bundle/v1",
  "kind": "SemanticRuntimeBundle",
  "release": {
    "releaseId": "org.contextobjects.nonclinical-safety@0.2.0",
    "packageId": "org.contextobjects.nonclinical-safety",
    "version": "0.2.0",
    "title": "Nonclinical Safety Semantic Runtime",
    "maturity": "preview",
    "compiledBy": "Context Studio",
    "sourceStandard": "CDISC SENDIG 3.0",
    "description": "Portable semantic, resolver, authorization, and presentation contract for evidence-led nonclinical safety review."
  },
  "objects": [
    {
      "id": "Compound",
      "label": "Compound",
      "kind": "business",
      "description": "Investigational material anchor. It may carry identifiers and normalized structure references without making SMILES the business model.",
      "sourceDomains": ["TS"],
      "retrieval": ["exact", "text", "chemical-fingerprint"],
      "visibleTo": ["toxicologist", "study-director", "data-steward", "portfolio-lead", "external-reviewer"],
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "Study",
      "label": "Study",
      "kind": "business",
      "description": "Immutable, versioned study snapshot and its protocol-level context.",
      "sourceDomains": ["TS"],
      "retrieval": ["exact", "text"],
      "visibleTo": ["toxicologist", "study-director", "data-steward", "portfolio-lead", "external-reviewer"],
      "position": { "x": 230, "y": 0 }
    },
    {
      "id": "TreatmentGroup",
      "label": "Treatment group",
      "kind": "business",
      "description": "Dose assignment and exposure context for a cohort of study subjects.",
      "sourceDomains": ["TX"],
      "retrieval": ["exact", "range"],
      "visibleTo": ["toxicologist", "study-director", "data-steward", "portfolio-lead", "external-reviewer"],
      "position": { "x": 470, "y": 0 }
    },
    {
      "id": "Subject",
      "label": "Animal subject",
      "kind": "business",
      "description": "Governed subject identity, group assignment, sex, species, and strain.",
      "sourceDomains": ["DM"],
      "retrieval": ["exact", "graph"],
      "visibleTo": ["toxicologist", "study-director", "data-steward", "external-reviewer"],
      "position": { "x": 700, "y": 0 }
    },
    {
      "id": "Finding",
      "label": "Microscopic finding",
      "kind": "evidence",
      "description": "An observed tissue finding with normalized organ, morphology, severity, subject, and source lineage.",
      "sourceDomains": ["MI"],
      "terminology": ["SEND controlled terminology", "solution concept dictionary"],
      "retrieval": ["exact", "text", "vector", "graph", "rerank"],
      "visibleTo": ["toxicologist", "study-director", "data-steward", "portfolio-lead", "external-reviewer"],
      "position": { "x": 470, "y": 180 }
    },
    {
      "id": "LabMeasurement",
      "label": "Laboratory measurement",
      "kind": "evidence",
      "description": "Longitudinal result with analyte, unit, study day, group, and subject context.",
      "sourceDomains": ["LB"],
      "retrieval": ["exact", "range", "vector"],
      "visibleTo": ["toxicologist", "study-director", "data-steward", "portfolio-lead", "external-reviewer"],
      "position": { "x": 700, "y": 180 }
    },
    {
      "id": "SourceArtifact",
      "label": "Source artifact",
      "kind": "governance",
      "description": "Checksum-verified XPT, Define-XML, or transformation artifact used to reproduce an assertion.",
      "sourceDomains": ["XPT", "Define-XML"],
      "retrieval": ["exact", "graph"],
      "visibleTo": ["toxicologist", "study-director", "data-steward", "external-reviewer"],
      "position": { "x": 930, "y": 180 }
    },
    {
      "id": "Publication",
      "label": "Scientific publication",
      "kind": "evidence",
      "description": "External contextual evidence with bibliographic identity, licensing, retrieval provenance, and explicit relevance to a study concept.",
      "sourceDomains": ["PubMed", "PMC OA"],
      "terminology": ["MeSH", "solution concept dictionary"],
      "retrieval": ["exact", "text", "vector", "graph", "rerank"],
      "visibleTo": ["toxicologist", "study-director", "data-steward", "portfolio-lead", "external-reviewer"],
      "position": { "x": 930, "y": 360 }
    },
    {
      "id": "DocumentChunk",
      "label": "Evidence passage",
      "kind": "evidence",
      "description": "Licensed, section-aware text fragment with page or passage locator, embedding, and parent-document provenance.",
      "sourceDomains": ["S3 document", "PubMed abstract", "PMC OA full text"],
      "retrieval": ["text", "vector", "rerank"],
      "visibleTo": ["toxicologist", "study-director", "data-steward", "portfolio-lead", "external-reviewer"],
      "position": { "x": 1160, "y": 360 }
    },
    {
      "id": "EvidenceAssertion",
      "label": "Evidence assertion",
      "kind": "intelligence",
      "description": "A snapshot-bound, cited hypothesis assembled by deterministic and AI-assisted retrieval.",
      "retrieval": ["text", "vector", "graph"],
      "visibleTo": ["toxicologist", "study-director", "data-steward", "portfolio-lead", "external-reviewer"],
      "position": { "x": 470, "y": 360 }
    },
    {
      "id": "ReviewDecision",
      "label": "Review decision",
      "kind": "workflow",
      "description": "Solution-owned annotation, classification, follow-up, approval, or rejection. It never mutates published SEND evidence.",
      "retrieval": ["exact", "text", "graph"],
      "visibleTo": ["toxicologist", "study-director", "data-steward"],
      "position": { "x": 700, "y": 360 }
    }
  ],
  "edges": [
    { "id": "compound-study", "from": "Compound", "to": "Study", "label": "evaluated in", "predicate": "safety:evaluatedIn" },
    { "id": "study-group", "from": "Study", "to": "TreatmentGroup", "label": "defines", "predicate": "safety:definesGroup" },
    { "id": "group-subject", "from": "TreatmentGroup", "to": "Subject", "label": "assigns", "predicate": "safety:assignsSubject" },
    { "id": "subject-finding", "from": "Subject", "to": "Finding", "label": "has finding", "predicate": "safety:hasFinding" },
    { "id": "subject-lab", "from": "Subject", "to": "LabMeasurement", "label": "has result", "predicate": "safety:hasLabResult" },
    { "id": "finding-lab", "from": "Finding", "to": "LabMeasurement", "label": "contextualized by", "predicate": "safety:contextualizedBy" },
    { "id": "finding-source", "from": "Finding", "to": "SourceArtifact", "label": "traces to", "predicate": "prov:wasDerivedFrom" },
    { "id": "lab-source", "from": "LabMeasurement", "to": "SourceArtifact", "label": "traces to", "predicate": "prov:wasDerivedFrom" },
    { "id": "finding-publication", "from": "Finding", "to": "Publication", "label": "contextualized by", "predicate": "safety:contextualizedByLiterature" },
    { "id": "publication-chunk", "from": "Publication", "to": "DocumentChunk", "label": "chunked into", "predicate": "safety:hasEvidencePassage" },
    { "id": "chunk-assertion", "from": "DocumentChunk", "to": "EvidenceAssertion", "label": "supports context", "predicate": "safety:contextForAssertion" },
    { "id": "finding-assertion", "from": "Finding", "to": "EvidenceAssertion", "label": "supports", "predicate": "safety:supportsAssertion" },
    { "id": "assertion-decision", "from": "EvidenceAssertion", "to": "ReviewDecision", "label": "reviewed as", "predicate": "safety:reviewedAs" }
  ],
  "profiles": [
    {
      "id": "toxicologist",
      "label": "Toxicologist",
      "description": "Investigates findings, adds interpretation, classifies relevance, and requests follow-up.",
      "grants": ["query:*", "action:annotate", "action:classify", "action:request-follow-up", "action:submit"],
      "maskedFields": []
    },
    {
      "id": "study-director",
      "label": "Study director",
      "description": "Reviews the complete evidence chain and approves or rejects submitted assessments.",
      "grants": ["query:*", "action:annotate", "action:classify", "action:request-follow-up", "action:submit", "action:approve", "action:reject"],
      "maskedFields": []
    },
    {
      "id": "data-steward",
      "label": "Data steward",
      "description": "Examines semantics, lineage, terminology, mappings, and data-quality discrepancies.",
      "grants": ["query:lineage", "query:model", "query:exact", "action:create-discrepancy"],
      "maskedFields": ["reviewerNarrative"]
    },
    {
      "id": "portfolio-lead",
      "label": "Portfolio lead",
      "description": "Reads aggregated signals and cross-study similarity without subject-level detail.",
      "grants": ["query:portfolio", "query:similarity", "query:model"],
      "hiddenObjects": ["Subject", "SourceArtifact", "ReviewDecision"],
      "maskedFields": ["subjectId", "sourcePath", "reviewerIdentity"]
    },
    {
      "id": "external-reviewer",
      "label": "External reviewer",
      "description": "Read-only access to published evidence, lineage, and submitted briefs.",
      "grants": ["query:published", "query:lineage", "query:model"],
      "maskedFields": ["internalNotes", "reviewerIdentity"]
    }
  ],
  "capabilities": [
    {
      "id": "rank-findings",
      "label": "Rank findings for review",
      "mode": "read",
      "description": "Structured incidence and severity aggregation bound to one immutable snapshot.",
      "engines": ["aggregation"],
      "reads": ["Study", "TreatmentGroup", "Finding"],
      "indexes": ["study_snapshot_signal"],
      "allowedProfiles": ["toxicologist", "study-director", "portfolio-lead", "external-reviewer"]
    },
    {
      "id": "expand-evidence-neighborhood",
      "label": "Expand evidence neighborhood",
      "mode": "read",
      "description": "Graph traversal from a finding to subjects, groups, labs, assertions, and lineage.",
      "engines": ["graph-lookup"],
      "reads": ["Finding", "Subject", "TreatmentGroup", "LabMeasurement", "SourceArtifact", "EvidenceAssertion"],
      "indexes": ["semantic_edge_from_to", "study_subject_domain"],
      "allowedProfiles": ["toxicologist", "study-director", "data-steward", "external-reviewer"]
    },
    {
      "id": "retrieve-similar-findings",
      "label": "Retrieve similar findings",
      "mode": "read",
      "description": "Cross-study retrieval over semantic concepts, normalized dose incidence, severity profiles, and optional embeddings, followed by reciprocal-rank fusion and domain reranking.",
      "engines": ["aggregation", "atlas-search", "vector-search", "graph-lookup", "rerank"],
      "reads": ["Finding", "Study", "Compound"],
      "indexes": ["finding_text", "finding_embedding"],
      "allowedProfiles": ["toxicologist", "study-director", "portfolio-lead"]
    },
    {
      "id": "assemble-evidence-brief",
      "label": "Assemble evidence brief",
      "mode": "read",
      "description": "Cited synthesis over authorized exact, graph, vector, and lineage results.",
      "engines": ["aggregation", "atlas-search", "vector-search", "graph-lookup", "agent-synthesis"],
      "reads": ["Finding", "LabMeasurement", "SourceArtifact", "EvidenceAssertion", "ReviewDecision"],
      "indexes": ["finding_text", "finding_embedding", "semantic_edge_from_to", "review_history"],
      "allowedProfiles": ["toxicologist", "study-director", "external-reviewer"]
    },
    {
      "id": "retrieve-literature-evidence",
      "label": "Retrieve literature evidence",
      "mode": "read",
      "description": "Ground study concepts to PubMed or licensed full text, perform hybrid retrieval, and rerank by species, organ, morphology, and study design.",
      "engines": ["atlas-search", "vector-search", "graph-lookup", "rerank"],
      "reads": ["Finding", "Publication", "DocumentChunk", "Compound"],
      "indexes": ["literature_text", "literature_embedding", "literature_concepts"],
      "allowedProfiles": ["toxicologist", "study-director", "data-steward", "portfolio-lead", "external-reviewer"]
    },
    {
      "id": "inspect-semantic-model",
      "label": "Inspect semantic model",
      "mode": "read",
      "description": "Explains how business objects bind to concepts, graph edges, resolvers, collections, and indexes.",
      "engines": ["semantic-registry"],
      "reads": ["Compound", "Study", "TreatmentGroup", "Subject", "Finding", "LabMeasurement", "SourceArtifact", "EvidenceAssertion", "ReviewDecision"],
      "indexes": ["semantic_object_id"],
      "allowedProfiles": ["toxicologist", "study-director", "data-steward", "portfolio-lead", "external-reviewer"]
    }
  ],
  "resolvers": [
    {
      "id": "resolver.rank-findings.v1",
      "capability": "rank-findings",
      "input": { "studyId": "string", "snapshotId": "string" },
      "output": "RankedFinding[]",
      "executor": "mongodb-aggregation",
      "policy": ["snapshot-bound", "read-only"],
      "stages": ["matchStudySnapshot", "unwindSignals", "scoreIncidenceSeverity", "sortReviewPriority"]
    },
    {
      "id": "resolver.evidence-neighborhood.v1",
      "capability": "expand-evidence-neighborhood",
      "input": { "studyId": "string", "snapshotId": "string", "findingId": "string" },
      "output": "EvidenceSubgraph",
      "executor": "mongodb-graph-lookup",
      "policy": ["snapshot-bound", "profile-filtered", "read-only"],
      "stages": ["authorizeProfile", "seedFinding", "graphLookup", "applyFieldMask", "attachLineage"]
    },
    {
      "id": "resolver.similar-findings.v1",
      "capability": "retrieve-similar-findings",
      "input": { "studyId": "string", "signalId": "string", "profileId": "string", "limit": "number" },
      "output": "ExplainablePortfolioMatch[]",
      "executor": "mongodb-portfolio-hybrid",
      "policy": ["profile-filtered", "citations-required", "read-only"],
      "containmentPlan": { "language": "contextobjects-containment-v1", "semantics": "AQL-CONTAINS", "rootArchetype": "archetype.study-evidence-aggregate.v1", "contains": ["Study", "TreatmentGroup", "Finding"], "compileTargets": ["mongodb-aggregation", "openehr-aql"] },
      "stages": ["compileSemanticScope", "semanticSearch", "compareNormalizedIncidence", "compareSeverityProfile", "optionalVectorSearch", "reciprocalRankFusion", "domainRerank", "authorizeResults"]
    },
    {
      "id": "resolver.evidence-brief.v1",
      "capability": "assemble-evidence-brief",
      "input": { "investigationId": "string" },
      "output": "EvidenceBrief",
      "executor": "magenta-agent-graph",
      "policy": ["citations-required", "no-regulatory-conclusion", "human-review"],
      "stages": ["plan", "executeAuthorizedTools", "rerankEvidence", "synthesize", "verifyCitations"]
    },
    {
      "id": "resolver.literature-evidence.v1",
      "capability": "retrieve-literature-evidence",
      "input": { "findingId": "string", "species": "string", "query": "string", "limit": "number" },
      "output": "LiteratureEvidence[]",
      "executor": "mongodb-hybrid-search",
      "policy": ["license-aware", "profile-filtered", "citations-required", "context-not-causality"],
      "containmentPlan": { "language": "contextobjects-containment-v1", "semantics": "AQL-CONTAINS", "rootArchetype": "archetype.contextual-literature-evidence.v1", "contains": ["Finding", "Publication", "DocumentChunk"], "compileTargets": ["mongodb-aggregation", "openehr-aql"] },
      "stages": ["groundConcepts", "filterLicensedCorpus", "lexicalSearch", "vectorSearch", "graphExpand", "domainRerank", "attachPassageCitations"]
    }
  ],
  "actions": [
    { "id": "annotate", "label": "Add expert annotation", "allowedProfiles": ["toxicologist", "study-director"], "writesCollection": "review_actions", "approval": "none", "immutableEvidence": true },
    { "id": "classify", "label": "Classify biological relevance", "allowedProfiles": ["toxicologist", "study-director"], "writesCollection": "review_actions", "approval": "none", "immutableEvidence": true },
    { "id": "request-follow-up", "label": "Request follow-up", "allowedProfiles": ["toxicologist", "study-director"], "writesCollection": "review_actions", "approval": "none", "immutableEvidence": true },
    { "id": "submit", "label": "Submit assessment", "allowedProfiles": ["toxicologist", "study-director"], "writesCollection": "review_actions", "approval": "study-director", "immutableEvidence": true },
    { "id": "approve", "label": "Approve evidence brief", "allowedProfiles": ["study-director"], "writesCollection": "review_actions", "approval": "four-eyes", "immutableEvidence": true },
    { "id": "reject", "label": "Return for revision", "allowedProfiles": ["study-director"], "writesCollection": "review_actions", "approval": "none", "immutableEvidence": true },
    { "id": "create-discrepancy", "label": "Create data discrepancy", "allowedProfiles": ["data-steward"], "writesCollection": "review_actions", "approval": "none", "immutableEvidence": true }
  ],
  "surfaces": [
    { "id": "business-documents", "label": "Business documents", "description": "Domain objects and the document fragments that keep a safety question local." },
    { "id": "semantic-graph", "label": "Semantic graph", "description": "Concepts, terminology bindings, predicates, and profile-filtered relationships." },
    { "id": "retrieval-projections", "label": "Search, graph & vectors", "description": "Resolver contracts and the exact indexes used by hybrid retrieval and the agent." },
    { "id": "physical-mongodb", "label": "Physical placements", "description": "MongoDB collections, API resources, object storage, paths, authority, and protected write boundaries." }
  ],
  "valueSets": [
    {
      "id": "finding-morphology",
      "label": "Microscopic finding morphology",
      "binding": "Finding.finding",
      "authority": "source-asserted + steward-reviewed",
      "version": "2026.09",
      "values": ["Decreased lymphocytes", "Mononuclear cell infiltration", "Inflammatory finding", "Increased fibroblasts"]
    },
    {
      "id": "anatomic-site",
      "label": "Nonclinical anatomic site",
      "binding": "Finding.organ",
      "authority": "SEND terminology projection",
      "version": "2026.09",
      "values": ["THYMUS", "LUNG", "HEART", "KIDNEY", "LIVER", "SITE, INJECTION"]
    }
  ],
  "taxonomy": {
    "concepts": [
      { "id": "evidence", "label": "Evidence", "kind": "taxonomy", "semanticObjects": ["Finding", "LabMeasurement", "Publication", "DocumentChunk"] },
      { "id": "observed-study-evidence", "label": "Observed study evidence", "kind": "concept", "broader": "evidence", "semanticObjects": ["Finding", "LabMeasurement"] },
      { "id": "external-contextual-evidence", "label": "External contextual evidence", "kind": "concept", "broader": "evidence", "semanticObjects": ["Publication", "DocumentChunk"] },
      { "id": "microscopic-finding", "label": "Microscopic finding", "kind": "concept", "broader": "observed-study-evidence", "synonyms": ["histopathology finding"], "valueSet": "finding-morphology", "externalMappings": ["SEND MI", "MeSH:Pathology"], "semanticObjects": ["Finding"] },
      { "id": "anatomic-site", "label": "Anatomic site", "kind": "terminology", "valueSet": "anatomic-site", "externalMappings": ["SEND controlled terminology", "MeSH Anatomy"], "semanticObjects": ["Finding", "Publication"] },
      { "id": "scientific-publication", "label": "Scientific publication", "kind": "concept", "broader": "external-contextual-evidence", "externalMappings": ["schema:ScholarlyArticle", "PubMed Publication"], "semanticObjects": ["Publication"] },
      { "id": "evidence-passage", "label": "Evidence passage", "kind": "concept", "broader": "external-contextual-evidence", "semanticObjects": ["DocumentChunk"] },
      { "id": "review-assertion", "label": "Review assertion", "kind": "concept", "semanticObjects": ["EvidenceAssertion", "ReviewDecision"] }
    ]
  },
  "archetypes": [
    {
      "id": "archetype.study-evidence-aggregate.v1",
      "label": "Study evidence aggregate",
      "description": "Snapshot-bound study root composed from protocol, treatment, finding, laboratory, and lineage roles.",
      "members": [
        { "role": "root", "semanticObject": "Study", "cardinality": "1" },
        { "role": "intervention", "semanticObject": "TreatmentGroup", "cardinality": "1..*" },
        { "role": "participant", "semanticObject": "Subject", "cardinality": "1..*" },
        { "role": "observation", "semanticObject": "Finding", "cardinality": "0..*" },
        { "role": "measurement", "semanticObject": "LabMeasurement", "cardinality": "0..*" },
        { "role": "lineage", "semanticObject": "SourceArtifact", "cardinality": "1..*" }
      ]
    },
    {
      "id": "archetype.contextual-literature-evidence.v1",
      "label": "Contextual literature evidence",
      "description": "Bibliographic identity plus permitted passages, semantic bindings, rights, and source locators.",
      "members": [
        { "role": "publication", "semanticObject": "Publication", "cardinality": "1" },
        { "role": "passage", "semanticObject": "DocumentChunk", "cardinality": "0..*" },
        { "role": "contextualizes", "semanticObject": "Finding", "cardinality": "1..*" }
      ]
    },
    {
      "id": "archetype.governed-evidence-brief.v1",
      "label": "Governed evidence brief",
      "description": "Cited agent hypothesis and append-only expert disposition over immutable evidence.",
      "members": [
        { "role": "assertion", "semanticObject": "EvidenceAssertion", "cardinality": "1" },
        { "role": "decision", "semanticObject": "ReviewDecision", "cardinality": "0..*" },
        { "role": "studyEvidence", "semanticObject": "Finding", "cardinality": "1..*" },
        { "role": "literatureContext", "semanticObject": "Publication", "cardinality": "0..*" }
      ]
    }
  ],
  "storageBindings": [
    { "id": "binding.compound.mongodb", "semanticObject": "Compound", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "document", "location": "compounds", "path": "compound", "authority": "projection" },
    { "id": "binding.study.mongodb.canonical", "semanticObject": "Study", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "document", "location": "study_snapshots", "path": "snapshot", "authority": "source" },
    { "id": "binding.study.mongodb.readmodel", "semanticObject": "Study", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "embedded-fragment", "location": "study_evidence", "path": "study", "authority": "projection" },
    { "id": "binding.group.mongodb.canonical", "semanticObject": "TreatmentGroup", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "document", "location": "cdisc_records", "path": "domain=TX.data", "authority": "source" },
    { "id": "binding.group.mongodb.readmodel", "semanticObject": "TreatmentGroup", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "embedded-fragment", "location": "study_evidence", "path": "doseGroups[]", "authority": "projection" },
    { "id": "binding.subject.mongodb.canonical", "semanticObject": "Subject", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "document", "location": "cdisc_records", "path": "domain=DM.data", "authority": "source" },
    { "id": "binding.subject.mongodb.projection", "semanticObject": "Subject", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "document", "location": "subjects", "path": "subject", "authority": "projection" },
    { "id": "binding.finding.mongodb.canonical", "semanticObject": "Finding", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "document", "location": "cdisc_records", "path": "domain=MI.data+facets", "authority": "source" },
    { "id": "binding.finding.mongodb.readmodel", "semanticObject": "Finding", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "embedded-fragment", "location": "study_evidence", "path": "signals[]", "authority": "projection" },
    { "id": "binding.finding.mongodb.portfolio", "semanticObject": "Finding", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "document", "location": "portfolio_findings", "path": "finding", "authority": "projection" },
    { "id": "binding.lab.mongodb.canonical", "semanticObject": "LabMeasurement", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "document", "location": "cdisc_records", "path": "domain=LB.data+facets", "authority": "source" },
    { "id": "binding.lab.mongodb.readmodel", "semanticObject": "LabMeasurement", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "embedded-fragment", "location": "study_evidence", "path": "labSeries", "authority": "projection" },
    { "id": "binding.artifact.mongodb", "semanticObject": "SourceArtifact", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "mongodb", "representation": "document", "location": "source_artifacts", "path": "artifact", "authority": "source" },
    { "id": "binding.artifact.s3", "semanticObject": "SourceArtifact", "archetype": "archetype.study-evidence-aggregate.v1", "adapter": "s3-documents", "representation": "object", "location": "source-artifacts", "path": "{studyId}/{sha256}", "authority": "source" },
    { "id": "binding.publication.pubmed", "semanticObject": "Publication", "archetype": "archetype.contextual-literature-evidence.v1", "adapter": "pubmed", "representation": "api-resource", "location": "pubmed.ncbi.nlm.nih.gov", "path": "/{pmid}", "authority": "source" },
