  "queryContracts": [
    {
      "id": "query.operational-safety-evidence.v1",
      "label": "Operational safety evidence",
      "queryClass": "operational",
      "resolverId": "resolver.biological-coherence.v1",
      "semanticIntent": "Resolve exact snapshot-bound SEND evidence across finding, treatment, subject, phase, laboratory, pathology, body-weight, food-consumption, organ-weight, and exposure contexts.",
      "scope": [
        "tenantId",
        "studyId",
        "snapshotId",
        "profileId",
        "signalId"
      ],
      "deterministicPredicates": [
        "canonical.domain",
        "_index.facets.subjectId",
        "_index.facets.organ",
        "_index.facets.testCode",
        "_index.facets.studyDay"
      ],
      "physicalPlan": {
        "engine": "mongodb-aggregation",
        "authority": "cdisc_records",
        "hydrate": [
          "study_endpoint_summaries",
          "measurement_series",
          "subject_timelines",
          "evidence_relationships"
        ]
      },
      "evidenceOutput": [
        "canonicalSourceRows",
        "sourceArtifacts",
        "executedQueryPlan",
        "executionStats"
      ]
    },
    {
      "id": "query.semantic-context.v1",
      "label": "Semantic context resolution",
      "queryClass": "semantic",
      "resolverId": "resolver.investigate-safety-signal.v1",
      "semanticIntent": "Resolve terminology, value sets, archetype containment, profile visibility, and logical-to-physical placement before executing evidence tools.",
      "scope": [
        "semanticReleaseId",
        "profileId",
        "question"
      ],
      "deterministicPredicates": [
        "resourceType",
        "resourceId",
        "visibleTo",
        "from",
        "predicate",
        "to"
      ],
      "physicalPlan": {
