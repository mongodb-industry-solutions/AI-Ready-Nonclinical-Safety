      "allowedProfiles": [
        "toxicologist",
        "study-director"
      ]
    },
    {
      "id": "retrieve-similar-findings",
      "label": "Retrieve similar findings",
      "mode": "read",
      "description": "Cross-study retrieval over semantic concepts, normalized dose incidence, severity profiles, and optional embeddings, followed by reciprocal-rank fusion and domain reranking.",
      "engines": [
        "aggregation",
        "atlas-search",
        "vector-search",
        "graph-lookup",
        "rerank"
      ],
      "reads": [
        "Finding",
