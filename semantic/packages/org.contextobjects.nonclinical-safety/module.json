      "engines": [
        "atlas-search",
        "vector-search",
        "graph-lookup",
        "rerank"
      ],
      "reads": [
        "Finding",
        "Publication",
        "DocumentChunk",
        "Compound"
      ],
      "indexes": [
        "literature_text",
