  "capabilities": [
    {
      "id": "rank-findings",
      "label": "Rank findings for review",
      "mode": "read",
      "description": "Structured incidence and severity analysis for one snapshot.",
      "engines": [
        "aggregation"
      ],
      "reads": [
        "Study",
        "TreatmentGroup",
        "Finding"
      ],
      "indexes": [
        "study_snapshot_signal"
      ],
      "allowedProfiles": [
        "toxicologist",
        "study-director",
        "portfolio-lead",
        "external-reviewer"
      ]
    },
    {
      "id": "expand-evidence-neighborhood",
      "label": "Expand evidence neighborhood",
