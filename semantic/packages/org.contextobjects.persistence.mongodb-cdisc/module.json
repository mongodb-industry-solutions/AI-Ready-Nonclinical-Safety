  "projectionRecipes": [
    {
      "id": "projection.study-evidence.v1",
      "sourceAuthority": "cdisc_records",
      "target": "study_evidence",
      "inputs": [
        "TS",
        "TX",
        "DM",
        "MI",
        "LB"
      ],
      "purpose": "Bounded study workspace cache",
      "rebuild": "snapshot-bound"
    },
    {
      "id": "projection.operational-evidence.v1",
      "sourceAuthority": "cdisc_records",
      "targets": [
        "study_endpoint_summaries",
        "measurement_series",
        "subject_timelines",
        "evidence_relationships"
      ],
      "inputs": [
        "DM",
        "TX",
        "MI",
        "MA",
        "LB",
        "OM",
        "BW",
        "BG",
        "FW",
        "CL",
        "EX",
        "PC",
        "PP",
        "SE",
        "DS",
        "RELREC"
      ],
      "purpose": "Operational safety queries and click-through",
      "rebuild": "snapshot-bound"
    },
    {
      "id": "projection.semantic-serving.v1",
      "sourceAuthority": "semantic_releases.bundle",
      "targets": [
        "semantic_resources",
        "semantic_edges",
        "semantic_search_documents"
      ],
      "purpose": "Profile-scoped inspection, graph traversal, and managed-vector retrieval",
      "rebuild": "release-bound"
    }
  ],
  "indexes": [
    {
      "collection": "cdisc_records",
      "name": "record_domain_order",
      "keys": {
        "_control.tenantId": 1,
        "_control.studyId": 1,
        "_control.snapshotId": 1,
        "canonical.domain": 1,
        "canonical.rowOrdinal": 1
      }
    },
    {
      "collection": "cdisc_records",
      "name": "subject_evidence",
      "keys": {
        "_control.tenantId": 1,
        "_control.studyId": 1,
        "_control.snapshotId": 1,
        "_index.facets.subjectId": 1,
        "canonical.domain": 1
      }
    },
    {
      "collection": "cdisc_records",
      "name": "finding_evidence",
      "keys": {
        "_control.tenantId": 1,
        "_control.studyId": 1,
        "_control.snapshotId": 1,
        "_index.facets.organ": 1,
        "_index.facets.finding": 1
      }
    },
    {
      "collection": "cdisc_records",
      "name": "measurement_evidence",
      "keys": {
        "_control.tenantId": 1,
        "_control.studyId": 1,
        "_control.snapshotId": 1,
        "_index.facets.testCode": 1,
        "_index.facets.studyDay": 1
      }
    },
    {
      "collection": "semantic_resources",
      "name": "release_type_visibility",
      "keys": {
        "releaseId": 1,
        "resourceType": 1,
        "visibleTo": 1
      }
    },
    {
      "collection": "semantic_edges",
      "name": "semantic_edge_forward",
      "keys": {
        "releaseId": 1,
        "from": 1,
        "predicate": 1,
        "to": 1
      }
    },
    {
      "collection": "semantic_edges",
      "name": "semantic_edge_reverse",
      "keys": {
        "releaseId": 1,
        "to": 1,
        "predicate": 1,
        "from": 1
      }
    },
    {
      "collection": "semantic_search_documents",
      "name": "semantic_map_auto_embed",
      "type": "atlas-vector-search",
      "sourcePath": "text",
      "storage": "__mdb_internal_search"
    }
  ]
}
