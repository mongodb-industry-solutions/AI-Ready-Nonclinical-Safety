# Default demo mode is deterministic and requires no infrastructure.
SAFETY_DATA_MODE=fixture

# Kehrnel mode: governed CDISC source of truth.
KEHRNEL_API_URL=http://localhost:8080
KEHRNEL_ENVIRONMENT_ID=local-cdisc
KEHRNEL_API_KEY=

# Optional Magenta agent gateway. The app keeps a deterministic read-only
# investigator when this is unset.
MAGENTA_AGENT_URL=
MAGENTA_AGENT_TOKEN=

# Solution-owned MongoDB data only: investigation sessions, reviewer feedback,
# and presentation read models. Canonical CDISC records remain in Kehrnel.
MONGODB_URI=
MONGODB_DATABASE=nonclinical_safety_solution
