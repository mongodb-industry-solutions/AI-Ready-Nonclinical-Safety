# The solution owns its deployment database and APIs. On first use it seeds the
# checksum-pinned public demonstration study when it is not already present.
MONGODB_URI=
MONGODB_DATABASE=nonclinical_safety_solution

# Optional live Magenta/LLM investigator. Docker Compose wires the internal
# agent service automatically; no Magenta URL is customer configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ATLAS_AUTO_EMBED_MODEL=voyage-4
ATLAS_SEARCH_INDEX=safety_evidence_search
ATLAS_EVIDENCE_AUTO_EMBED_INDEX=safety_evidence_auto_embed
ATLAS_LITERATURE_SEARCH_INDEX=safety_literature_search
ATLAS_LITERATURE_AUTO_EMBED_INDEX=safety_literature_auto_embed
ATLAS_PORTFOLIO_SEARCH_INDEX=safety_portfolio_search
ATLAS_PORTFOLIO_AUTO_EMBED_INDEX=safety_portfolio_auto_embed

# Optional governed full-text location. The public fixture stores metadata and
# application-authored summaries only.
DOCUMENT_BUCKET=
